# Пример конфигурации. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Переменные ниже задаются docker-compose; дефолты есть в src/core/config.py
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=change-me
# DB_NAME=tickets_db
# REDIS_HOST=redis
# REDIS_PORT=6379
